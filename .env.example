# Local Operations works with the remote backend disabled.
VITE_TUX_REMOTE_BACKEND_MODE=disabled

# Desktop development only. Production loads the built Operations renderer.
TUX_OPERATIONS_DEV_URL=http://localhost:5173

# Optional automatic outbox endpoint. Leave empty for honest local-only Operations.
TUX_SYNC_ENDPOINT=
TUX_SYNC_BEARER_TOKEN=
VITE_TUX_SYNC_ENDPOINT=

