# Browser Operations can be enrolled interactively without env values. These optional
# public client values prefill the browser device-setup screen when deployed.
VITE_TUX_SUPABASE_URL=
VITE_TUX_SUPABASE_PUBLISHABLE_KEY=

# Desktop Operations uses the same public Supabase client values from the main process.
TUX_SUPABASE_URL=
TUX_SUPABASE_PUBLISHABLE_KEY=

# Desktop development only. Production loads the built Operations renderer.
TUX_OPERATIONS_DEV_URL=http://localhost:5173

# Optional explicit sync endpoint overrides. Normally derived from the Supabase URL.
TUX_SYNC_ENDPOINT=
VITE_TUX_SYNC_ENDPOINT=

# Never commit or bake service-role keys, database passwords, device enrollment codes,
# device access/refresh tokens, or worker PINs into frontend environment variables.
