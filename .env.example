# Local Operations works with the remote backend disabled when the server-only
# Supabase gateway variables below are absent.
VITE_TUX_REMOTE_BACKEND_MODE=disabled

# Desktop development only. Production loads the built Operations renderer.
TUX_OPERATIONS_DEV_URL=http://localhost:5173

# Server-only Supabase gateway credentials.
# On Vercel, configure these as Environment Variables without any VITE_ prefix.
# They are read only by /api serverless functions and must never be rendered into the worker UI.
TUX_SUPABASE_URL=
TUX_SUPABASE_PUBLISHABLE_KEY=

# Desktop first-run enrollment only. Browser enrollment uses the one-time
# enrollment code entered on the Device setup screen and never asks for a
# Supabase URL or project key.
TUX_DEVICE_ENROLLMENT_CODE=
TUX_DEVICE_ID=
TUX_DEVICE_LABEL=

# Optional desktop automatic-outbox override. When empty, desktop derives the
# Supabase Edge Function endpoint from TUX_SUPABASE_URL.
TUX_SYNC_ENDPOINT=
TUX_SYNC_BEARER_TOKEN=
