{
  "name": "tux-v2",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.0 <27"
  },
  "scripts": {
    "dev:operations": "npm run dev -w @tux/operations",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint \"{apps,packages}/**/*.{ts,tsx}\" --max-warnings 0",
    "test": "vitest run",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,html,json}\" \"packages/**/*.{ts,tsx,css,json}\" \"*.{json,mjs}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,html,json}\" \"packages/**/*.{ts,tsx,css,json}\" \"*.{json,mjs}\" \".github/**/*.yml\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "electron": "43.2.0",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
