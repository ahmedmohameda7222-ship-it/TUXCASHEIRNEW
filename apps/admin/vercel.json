{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npm run build:admin",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/admin/customers",
      "dest": "/api/admin/orders?__adminResource=customers"
    },
    {
      "src": "/api/admin/staff",
      "dest": "/api/admin/orders?__adminResource=staff"
    },
    {
      "src": "/api/admin/delivery",
      "dest": "/api/admin/orders?__adminResource=delivery"
    },
    {
      "src": "/api/admin/finance",
      "dest": "/api/admin/orders?__adminResource=finance"
    },
    {
      "src": "/api/admin/reports",
      "dest": "/api/admin/orders?__adminResource=reports"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "includeFiles": [
        "../../packages/domain/src/**",
        "../../packages/domain/dist/**"
      ]
    }
  }
}
