{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npm run build:admin",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/admin/customers",
      "dest": "/api/admin/orders?__adminResource=customers"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
