{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npm run build:admin",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/admin/shop-create",
      "dest": "/api/admin/settings?__adminResource=shop-create"
    },
    {
      "src": "/api/admin/shop-copy-preview",
      "dest": "/api/admin/settings?__adminResource=shop-copy-preview"
    },
    {
      "src": "/api/admin/payment-zone-rules",
      "dest": "/api/admin/settings?__adminResource=payment-zone-rules"
    },
    {
      "src": "/api/admin/approval-rules",
      "dest": "/api/admin/approvals?__adminResource=approval-rules"
    },
    {
      "src": "/api/admin/customers",
      "dest": "/api/admin/orders?__adminResource=customers"
    },
    {
      "src": "/api/admin/staff",
      "dest": "/api/admin/orders?__adminResource=staff"
    },
    {
      "src": "/api/admin/delivery",
      "dest": "/api/admin/orders?__adminResource=delivery"
    },
    {
      "src": "/api/admin/finance",
      "dest": "/api/admin/orders?__adminResource=finance"
    },
    {
      "src": "/api/admin/reports",
      "dest": "/api/admin/orders?__adminResource=reports"
    },
    {
      "src": "/api/admin/alerts",
      "dest": "/api/admin/orders?__adminResource=alerts"
    },
    {
      "src": "/api/admin/operations-health",
      "dest": "/api/admin/orders?__adminResource=operations-health"
    },
    {
      "src": "/api/admin/whatsapp",
      "dest": "/api/admin/orders?__adminResource=whatsapp"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "../../packages/domain/{src,dist}/**"
    }
  }
}
