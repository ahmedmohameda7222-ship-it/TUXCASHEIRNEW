{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npm run build -w @tux/operations",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "../../packages/{domain,application}/src/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/device-bootstrap",
      "destination": "/api/device?route=device-bootstrap"
    },
    {
      "source": "/api/device-enroll",
      "destination": "/api/device?route=device-enroll"
    },
    {
      "source": "/api/device-session",
      "destination": "/api/device?route=device-session"
    },
    {
      "source": "/api/worker-auth",
      "destination": "/api/worker?route=worker-auth"
    },
    {
      "source": "/api/worker-menu-layout",
      "destination": "/api/worker?route=worker-menu-layout"
    },
    {
      "source": "/api/worker-ui-preferences",
      "destination": "/api/worker?route=worker-ui-preferences"
    }
  ],
  "crons": [
    {
      "path": "/api/whatsapp-media-retention",
      "schedule": "17 3 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ] || [ \"$VERCEL_GIT_COMMIT_REF\" = \"fix/vercel-runtime-workspace-packaging\" ]; then exit 1; else exit 0; fi"
}
