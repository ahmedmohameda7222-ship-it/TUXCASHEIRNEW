{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@tux/domain": ["../../packages/domain/src/index.ts"],
      "@tux/application": ["../../packages/application/src/index.ts"]
    },
    "noEmit": true
  },
  "include": ["src", "vite.config.ts"]
}
